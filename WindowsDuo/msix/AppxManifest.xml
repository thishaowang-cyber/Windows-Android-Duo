<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package manifest.

  Windows.Graphics.Capture refuses to hand out a capture item to a process with
  no package identity (CreateForMonitor returns E_ACCESSDENIED, and
  GraphicsCaptureAccess reports NotDeclaredByApp). Registering this manifest
  around the already-built executable gives the process that identity without
  repackaging or moving a single file — the payload stays where the build put it.

  Registering a sparse package in Developer Mode needs no signing certificate and
  no Windows SDK:
      Add-AppxPackage -Register <build output>\AppxManifest.xml
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">

  <Identity
    Name="WindowsDuo.Sparse"
    Publisher="CN=WindowsDuoDev"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Windows Duo</DisplayName>
    <PublisherDisplayName>Windows Duo</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application
      Id="WindowsDuo"
      Executable="WindowsDuo.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="Windows Duo"
        Description="Hinge-driven glass desktop effect"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <!-- Launching through the alias is what actually grants package identity;
           running the exe straight out of the folder does not. It also keeps the
           command line usable, which the package-activation route does not. -->
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="WindowsDuo.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="WindowsDuo.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Required to call GraphicsCaptureAccess.RequestAccessAsync(Programmatic)
         and GraphicsCaptureItem.TryCreateFromDisplayId, the supported route for
         capturing a display without a picker. -->
    <rescap:Capability Name="graphicsCaptureProgrammatic" />
  </Capabilities>
</Package>
